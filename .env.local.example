# ─── Base de datos (Supabase) ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ─── MailerLite ───────────────────────────────────────────────────────────────
# MailerLite → Integrations → API → API Tokens → Create token
MAILERLITE_API_KEY=tu_api_key_aqui

# MailerLite → Subscribers → Groups → crea un grupo "Guia gratis" → copia el ID de la URL
MAILERLITE_GROUP_ID=tu_group_id_aqui

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# URL publica de tu web (sin slash final)
NEXT_PUBLIC_URL=https://www.mvf.coach

# ─── Admin Dashboard ──────────────────────────────────────────────────────────
# Contraseña para acceder a /admin — ponla también en Vercel → Settings → Env Variables
ADMIN_SECRET_TOKEN=pon-aqui-una-contrasena-fuerte

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# GA4 → Admin → Data Streams → tu stream → Measurement ID (empieza por G-)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
