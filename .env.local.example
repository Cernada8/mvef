# ─── Mailchimp ────────────────────────────────────────────────────────────────
# Obtén tu API key en: Mailchimp → Account → Extras → API Keys
MAILCHIMP_API_KEY=tu_api_key_aqui

# ID de tu audiencia: Mailchimp → Audience → Manage Audience → Settings
MAILCHIMP_LIST_ID=tu_list_id_aqui

# Prefijo del servidor: aparece en la URL del dashboard, ej. "us21"
MAILCHIMP_SERVER_PREFIX=us21

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Clave secreta: Stripe Dashboard → Developers → API Keys → Secret key
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXX

# URL pública de tu web (sin slash final)
NEXT_PUBLIC_URL=https://www.mvf.coach
